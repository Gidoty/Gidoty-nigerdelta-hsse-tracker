{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "mutate": ["src/utils/methaneCalc.js", "src/utils/integrity.js"],
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run src/utils/methaneCalc.test.js src/utils/integrity.test.js"
  },
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "coverageAnalysis": "off",
  "concurrency": 2
}
